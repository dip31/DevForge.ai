# ─────────────────────────────────────────────────────────────────────────────
# DevForge.ai — API server environment
# Copy to apps/api/.env and fill in real values.
# NEVER commit .env files. See .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ── Supabase ──────────────────────────────────────────────────────────────────
# Dashboard: Project → Settings → API

# Project URL (same value used in the frontend VITE_SUPABASE_URL)
SUPABASE_URL=https://<project-ref>.supabase.co

# Secret key — server-only, NEVER expose to the browser
# Dashboard: Settings → API → Project API keys → service_role
SUPABASE_SECRET_KEY=<service_role_key>

# JWT secret for verifying access tokens locally (HS256)
# Dashboard: Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=<your-jwt-secret-at-least-32-chars>

# ── Database ──────────────────────────────────────────────────────────────────
# Dashboard: Project → Settings → Database → Connection string

# Runtime connection — use Session pooler (port 5432) for this long-lived server
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Direct connection for Drizzle migrations (port 5432, not the pooler)
# Dashboard: Settings → Database → Connection string → URI
DATABASE_MIGRATION_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

DATABASE_POOL_SIZE=10
DATABASE_SSL=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to the web app origin
CORS_ORIGIN=http://localhost:8443
CORS_CREDENTIALS=true

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=true

# ── Optional integrations — server starts without these ───────────────────────

# Stripe (billing)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# AI providers
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Groq (AI Coach) — server-only, NEVER expose to the browser
# Create a key at https://console.groq.com/keys
# The env file must live in apps/api/.env (the server loads it from its own cwd).
# GROQ_API_KEY=gsk_...
# openai/gpt-oss-120b is a reasoning model: keep a generous output-token budget
# so reasoning does not crowd out the answer.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TIMEOUT_MS=30000
# GROQ_MAX_OUTPUT_TOKENS=4096

# SMTP (notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=password
# SMTP_FROM=noreply@devforge.ai

# Redis (future queue support)
# REDIS_URL=redis://localhost:6379

# S3-compatible storage (execution artifacts)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=devforge-artifacts
# S3_REGION=us-east-1

# Executor service (isolated code runner)
# EXECUTOR_URL=http://localhost:4000
# EXECUTOR_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Frontend (apps/web/.env) — separate file, VITE_ prefix required
# ─────────────────────────────────────────────────────────────────────────────
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=<anon_key>
# VITE_API_URL=http://localhost:3000
